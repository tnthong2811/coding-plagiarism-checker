# ========================================
# PostgreSQL Configuration
# ========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_secure_password_here
POSTGRES_DB=plagiarism_db

# ========================================
# MongoDB Configuration
# ========================================
# MongoDB không yêu cầu auth trong docker-compose dev
# Nếu bạn muốn bật auth, sử dụng: mongodb://user:pass@mongodb:27017/plagiarism_reports

# ========================================
# RabbitMQ Configuration
# ========================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ========================================
# MinIO Configuration (S3-compatible Object Storage)
# ========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password_here
MINIO_BUCKET_NAME=submissions

# ========================================
# Spring Boot Application Properties
# ========================================
# Auth Service
AUTH_SERVICE_PORT=8081
JWT_SECRET=your-jwt-secret-key-changeme-in-production
# Optional first admin bootstrap (leave blank to disable)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Submission Service
SUBMISSION_SERVICE_PORT=8082
MINIO_URL=http://minio:9000

# Analyzer Service
ANALYZER_SERVICE_PORT=8083
SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/plagiarism_reports

# ========================================
# Timezone Configuration
# ========================================
# Đặt TZ để sử dụng múi giờ Việt Nam (UTC+7)
# Thay đổi giá trị này nếu bạn ở múi giờ khác
# Ví dụ khác: UTC, America/New_York, Europe/London, Asia/Bangkok
TZ=Asia/Ha_Noi

